# Mô hình ngôn ngữ (API tương thích OpenAI)

# OpenRouter. Lấy khóa tại https://openrouter.ai/keys
# Giữ qwen-2.5-7b để điểm nền so được với bản Streamlit gốc.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen-2.5-7b-instruct

# Ollama trên máy (thay ba dòng trên)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Dịch vụ tìm kiếm (services/rag)
DATABASE_URL=postgresql://theoryoj:theoryoj@127.0.0.1:5433/theoryoj
# DEVICE=cuda                 # mặc định tự chọn cuda nếu torch có CUDA
# RERANK_ENABLED=true
# RAG_API_KEY=                # đặt để bảo vệ POST /ingest

# Web (apps/web). Next.js đọc file .env này khi chạy từ apps/web.
RAG_URL=http://127.0.0.1:8001
# REFUSAL_THRESHOLD=0.3       # ngưỡng điểm reranker, dưới ngưỡng thì từ chối (PLAN.md mục 2.4)
# LLM_FAST_MODEL=             # mô hình cho bước phân loại và viết lại câu hỏi, mặc định dùng LLM_MODEL

# Giới hạn câu hỏi gửi trợ lý: mỗi trình duyệt trong 10 phút, trong một ngày; mỗi IP trong 10 phút
# CHAT_LIMIT_VISITOR_10M=20
# CHAT_LIMIT_VISITOR_DAY=200
# CHAT_LIMIT_IP_10M=120
