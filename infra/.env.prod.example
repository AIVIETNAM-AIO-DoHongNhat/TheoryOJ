# Cấu hình bản triển khai. Chép thành infra/.env (không đưa lên Git) rồi điền.

# Tên miền trỏ về máy chủ, Caddy tự cấp HTTPS. Email nhận thông báo chứng chỉ.
DOMAIN=ktct.example.edu.vn
ACME_EMAIL=

# Sinh ngẫu nhiên, ví dụ: openssl rand -base64 32
POSTGRES_PASSWORD=
# Bảo vệ POST /ingest của dịch vụ tìm kiếm.
RAG_API_KEY=

# Mô hình ngôn ngữ (PLAN.md mục 11, quyết định 1).
# Chạy tại chỗ bằng Ollama (bật --profile ollama):
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# LLM_FAST_MODEL=
# Hoặc API ngoài, chỉ khi Học viện cho phép:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen-2.5-7b-instruct

# Tìm kiếm: để trống thì tự chọn cuda nếu có. Dùng infra/docker-compose.gpu.yml để cấp GPU cho container.
# RAG_DEVICE=cpu
# REFUSAL_THRESHOLD=0.3

# Giới hạn câu hỏi: mỗi trình duyệt trong 10 phút, trong một ngày; mỗi IP trong 10 phút.
# Cả lớp dùng chung một IP (mạng nội bộ) thì nâng CHAT_LIMIT_IP_10M, ví dụ 50 học viên x 20 câu = 1000.
CHAT_LIMIT_VISITOR_10M=20
CHAT_LIMIT_VISITOR_DAY=200
CHAT_LIMIT_IP_10M=1000

# Đợt khảo sát ở /khao-sat: truoc (đầu đợt thử nghiệm), sau (cuối đợt), dong.
SURVEY_PHASE=truoc

BACKUP_KEEP_DAYS=14
