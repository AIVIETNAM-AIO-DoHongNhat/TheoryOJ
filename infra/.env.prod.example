# Cấu hình bản triển khai. Chép thành infra/.env (không đưa lên Git) rồi điền.

# Tên miền trỏ về máy chủ, Caddy tự cấp HTTPS. Chạy sau Cloudflare Tunnel thì đặt DOMAIN=:80 (chỉ HTTP).
DOMAIN=ktct.example.edu.vn

# Sinh ngẫu nhiên, ví dụ: openssl rand -base64 32
# Lưu ý: Postgres chỉ nhận mật khẩu lúc tạo volume. Nếu đã chạy infra/docker-compose.yml (bản phát triển) và muốn
# dùng lại chỉ mục có sẵn thì đặt đúng mật khẩu của volume đó (mặc định theoryoj).
POSTGRES_PASSWORD=
# Bảo vệ POST /ingest của dịch vụ tìm kiếm.
RAG_API_KEY=

# Mô hình ngôn ngữ (PLAN.md mục 11, quyết định 1).
# Mặc định: OpenRouter. Khóa này cũng dùng cho embedding và rerank của dịch vụ tìm kiếm.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_FAST_MODEL=
# Hoặc chạy tại chỗ bằng Ollama (bật --profile ollama, xem mục 8 của TRIEN-KHAI.md):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Tìm kiếm: mặc định gọi OpenRouter (dùng chung LLM_API_KEY), image rag nhẹ, không cần GPU.
# Mô hình embedding giữ nguyên bge-m3 nên chỉ mục cũ dùng được. Reranker mỗi mô hình một thang điểm:
# đổi RERANK_MODEL thì phải đo lại REFUSAL_THRESHOLD (make eval, make eval-chat).
EMBED_PROVIDER=openrouter
RERANK_PROVIDER=openrouter
EMBED_MODEL=baai/bge-m3
RERANK_MODEL=cohere/rerank-v3.5
# OPENROUTER_API_KEY=            # bỏ trống thì dùng LLM_API_KEY
# Chạy mô hình tìm kiếm trên máy chủ thay vì OpenRouter (cần RAM/GPU, xem infra/docker-compose.gpu.yml):
# EMBED_PROVIDER=local
# RERANK_PROVIDER=local
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_LOCAL_MODELS=1
# RAG_DEVICE=cpu
# REFUSAL_THRESHOLD=0.44      # đo với cohere/rerank-v3.5 (bge-reranker-v2-m3 thì 0.3)

# Giới hạn câu hỏi: mỗi trình duyệt trong 10 phút, trong một ngày; mỗi IP trong 10 phút.
# Cả lớp dùng chung một IP (mạng nội bộ) thì nâng CHAT_LIMIT_IP_10M, ví dụ 50 học viên x 20 câu = 1000.
CHAT_LIMIT_VISITOR_10M=20
CHAT_LIMIT_VISITOR_DAY=200
CHAT_LIMIT_IP_10M=1000

# Đợt khảo sát ở /khao-sat: truoc (đầu đợt thử nghiệm), sau (cuối đợt), dong.
SURVEY_PHASE=truoc

BACKUP_KEEP_DAYS=14
